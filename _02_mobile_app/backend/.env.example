# ─────────────────────────────────────────────────────────────────────────────
# Digital Twin Backend — environment variables template
# Copy this file to  backend/.env  and fill in your real values.
# Never commit  backend/.env  to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT broker (publisher_multi_machine.py) ──────────────────────────────────
# Default (cloud): values below are already the production defaults in code.
# Override here only for Plan-B local fallback:
#
#   MQTT_BROKER=127.0.0.1
#   MQTT_PORT=1883
#   MQTT_USE_TLS=false
#   MQTT_USERNAME=
#   MQTT_PASSWORD=
#
# Flutter Plan-B (run these in terminal before `flutter run`):
#   flutter run \
#     --dart-define=MQTT_BROKER=192.168.1.x \
#     --dart-define=MQTT_PORT=1883 \
#     --dart-define=MQTT_WS_PORT=9001 \
#     --dart-define=MQTT_USE_TLS=false \
#     --dart-define=MQTT_USERNAME= \
#     --dart-define=MQTT_PASSWORD=

# ── Cloudinary (image upload API) ────────────────────────────────────────────
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Get these from https://console.cloudinary.com → Settings → Access Keys
