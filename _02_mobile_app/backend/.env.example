# ─────────────────────────────────────────────────────────────────────────────
# Digital Twin Backend — environment variables template
# Copy this file to  backend/.env  and fill in your real values.
# Never commit  backend/.env  to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudinary (image upload API) ────────────────────────────────────────────
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Get these from https://console.cloudinary.com → Settings → Access Keys
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# ── Firebase Admin SDK (POST /admin/create-user) ─────────────────────────────
# Path to your Firebase service-account JSON file.
# Absolute path recommended; relative paths are resolved from backend/.
#
# How to get the JSON file:
#   1. Go to Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key"
#   3. Save the downloaded JSON somewhere safe (NOT inside the repo)
#   4. Set the path below
#
# Example (absolute):
#   FIREBASE_SERVICE_ACCOUNT_PATH=/home/user/secrets/my-project-firebase.json
# Example (relative to backend/):
#   FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/my-project-firebase.json
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/your/firebase-service-account.json
