.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------------------------------------
# Binary / Large Non-Code Assets
